{
  "name": "erpnext-playwright-ai-test-automation",
  "version": "0.1.0",
  "description": "AI-assisted Playwright test automation for ERPNext: test cases written by a tester, tests generated by an AI agent, kept honest by rules, lint and CI.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "lint": "eslint . && node scripts/check-testdata.js",
    "seed": "node src/seed/run.js",
    "check": "node src/seed/check.js",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:chromium": "playwright test --project=chromium",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --headed --project=chromium --workers=1",
    "report": "node scripts/open-report.js",
    "report:playwright": "playwright show-report .results/html"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "dotenv": "16.4.5",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "globals": "^17.13.0",
    "reporting-labs": "0.6.13",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
