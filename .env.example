# Copy to .env. These values match the local Docker stack in docker/pwd.yml only.
# Never put a real system's credentials here.
BASE_URL=http://localhost:8080
ADMIN_USER=Administrator
ADMIN_PASSWORD=admin
# Password of the demo users the seed creates (cashiers, manager, admin), local Docker site only.
DEMO_USER_PASSWORD=Demo-adde517de940-Qa1
# Where `npm run erp:backup` saves backups. Default: ../erpnext-backups (next to this repository).
# With Google Drive for desktop installed, backups also go to Google Drive, e.g.:
# BACKUP_DIR=G:\My Drive\ERPNext-Backups
# How many backups to keep (older ones are deleted). Default: 30
# BACKUP_KEEP=30
